# Compact configs, episode summaries, and pruning records are scientific inputs.
# Large per-step inputs stay local and are inventoried in protected_inputs.json.
**/runs_aborted/
**/.locks/
**/*.log
**/*.lock

# Bulky per-step artifacts outside the raw run directories.
**/rollout/*/
**/traces/
**/*.mp4
**/*.jpg
**/wandb/
**/frames/
**/selector/
**/horizon/
# Chained launch logs (Ray/progress noise) and
# derived files over GitHub's 100 MB limit (aggregate.py rebuilds masks.parquet from the runs).
**/driver.log
**/driver.log.partial
token_prune/results/masks.parquet
# NavVerse arms (ctx_ablation_navverse): per-episode trajectory/action dumps and videos stay local;
# result.json, server_config.json and server_steps.jsonl are the inputs aggregate.py reads.
ctx_ablation_navverse/runs/*/*/data/
ctx_ablation_navverse/runs/*/*/vid/

# LightNav-0 NavVerse arms: per-step pruning records (~1.5 KB per step, tens of MB per arm) stay local;
# server_config.json / server_steps.jsonl carry the per-step summary aggregate.py reads.
ctx_ablation_navverse/runs/*/prune/

# Server-ready marker files written by the LightNav / NavVerse launch scripts.
**/*.ready

# Kept locally, not on GitHub (2026-11-20: code and documentation only for the newer studies);
# see the two variant sections of paper/frame_influence/README.md.
frame_influence_recent/
frame_influence_keepone_full/
